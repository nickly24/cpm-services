# Copying this file alone is insufficient: generate unique local passwords.
MYSQL_IMAGE=mysql:8.0.46
# Match the production major version from schema/mongo.json before first startup.
MONGO_IMAGE=mongo:8.0.17
MYSQL_PORT=13306
MONGO_PORT=27018
MYSQL_DATABASE=cpm_dev
MYSQL_USER=cpm_dev
MYSQL_PASSWORD=replace-with-random-local-password
MYSQL_ROOT_PASSWORD=replace-with-random-local-password
MONGO_DATABASE=cpm_dev
MONGO_USER=cpm_dev
MONGO_PASSWORD=replace-with-random-local-password
MONGO_ROOT_USER=cpm_dev_root
MONGO_ROOT_PASSWORD=replace-with-random-local-password
JWT_SECRET_KEY=replace-with-random-local-secret

# RabbitMQ stays stopped until ./dev/dev rabbit-up is explicitly called.
RABBITMQ_IMAGE=rabbitmq:4.3.6-management
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=cpm_dev
RABBITMQ_PASSWORD=replace-with-random-local-password
RABBITMQ_VHOST=cpm_dev
RABBITMQ_ERLANG_COOKIE=replace-with-random-local-cookie
# URLs are derived by scripts/rabbit_env.py; never commit credential-bearing URLs.
